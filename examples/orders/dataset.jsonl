{"id": "order_status", "input": "Where is order A100?", "expected_output": "Order A100 is shipped.", "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "A100"}}]}
{"id": "order_not_found", "input": "Where is order Z999?", "expected_output": "I could not find order Z999.", "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "Z999"}}]}
{"id": "latest_order", "input": "What is the status of the latest order for bob@example.com?", "expected_output": "Your latest order A102 is delivered.", "expected_tool_calls": [{"name": "find_customer", "arguments": {"email": "bob@example.com"}}, {"name": "get_order", "arguments": {"order_id": "A102"}}]}
{"id": "unknown_customer", "input": "What is the status of the latest order for dan@example.com?", "expected_output": "I could not find a customer with that email.", "expected_tool_calls": [{"name": "find_customer", "arguments": {"email": "dan@example.com"}}]}
{"id": "total_spend", "input": "How much did carol@example.com spend?", "expected_output": "Carol spent 17.50 across 2 orders.", "expected_tool_calls": [{"name": "find_customer", "arguments": {"email": "carol@example.com"}}, {"name": "get_order", "arguments": {"order_id": "A103"}}, {"name": "get_order", "arguments": {"order_id": "A104"}}, {"name": "get_order", "arguments": {"order_id": "A105"}}], "expected_tools": ["find_customer", "get_order"], "tool_order": ["find_customer", "get_order"], "max_tool_calls": 4}
{"id": "refund_eligible", "input": "Please refund order A102.", "output_contains": ["Refunded 12.00", "A102"], "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "A102"}}, {"name": "issue_refund", "arguments": {"order_id": "A102", "amount": 12.0}}], "tool_order": ["get_order", "issue_refund"], "expected_tool_args": [{"tool": "issue_refund", "args": {"order_id": "A102", "amount": 12.0}}]}
{"id": "refund_not_delivered", "input": "Please refund order A100.", "expected_output": "Order A100 is not eligible for a refund because it has not been delivered.", "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "A100"}}], "forbidden_tools": ["issue_refund"], "max_tool_calls": 1}
{"id": "refund_outside_window", "input": "Please refund order A101.", "expected_output": "Order A101 is not eligible for a refund because it was delivered more than 30 days ago.", "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "A101"}}], "forbidden_tools": ["issue_refund"]}
{"id": "refund_unknown_order", "input": "Please refund order Z999.", "expected_output": "I could not find order Z999.", "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "Z999"}}]}
{"id": "order_summary_json", "input": "json: summary of order A101", "expected_json_schema": {"type": "object", "required": ["order_id", "status", "total", "item_count"], "additionalProperties": false, "properties": {"order_id": {"const": "A101"}, "status": {"const": "delivered"}, "total": {"type": "number"}, "item_count": {"const": 2}}}, "expected_tool_calls": [{"name": "get_order", "arguments": {"order_id": "A101"}}]}
{"id": "out_of_scope", "input": "Tell me a joke.", "expected_output": "I can only help with orders.", "expected_tool_calls": []}
